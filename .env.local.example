# Supabase project settings (Project Settings > API in the Supabase dashboard)
# These two are safe to expose to the browser — they are public by design and
# access is enforced by Row Level Security, not by secrecy of these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Used exclusively by src/lib/supabase/admin.ts to invite new
# staff/teacher/admin accounts (supabase.auth.admin.inviteUserByEmail).
# NEVER prefix this with NEXT_PUBLIC_, never import admin.ts from a 'use
# client' file, and never commit the real value. Find it in Project
# Settings > API > service_role (click "Reveal").
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional. Used to build the redirect link in staff invite emails. If
# unset, the app derives it from the incoming request's Host header
# (works for both localhost and your deployed domain).
# NEXT_PUBLIC_SITE_URL=https://your-school-portal.netlify.app
